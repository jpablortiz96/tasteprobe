{
  "name": "tasteprobe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "smoke:qloo": "node --env-file-if-exists=.env.local scripts/qloo-smoke.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
