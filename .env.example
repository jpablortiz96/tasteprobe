QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
# Prefer TMDB_READ_ACCESS_TOKEN. Either TMDB credential is optional.
# Development-only review: set manually to synthetic; never enable for production.
TASTEPROBE_VISUAL_REVIEW=
# Public Railway runtime only. Keep empty for local loopback development.
TASTEPROBE_DEPLOYMENT=
TASTEPROBE_PUBLIC_ORIGIN=
TASTEPROBE_SIGNING_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TASTEPROBE_QUOTA_NAMESPACE=
TASTEPROBE_QLOO_TOTAL_LIMIT=
TASTEPROBE_TMDB_TOTAL_LIMIT=
# Optional: x-real-ip or cf-connecting-ip ONLY if trusted ingress overwrites it.
# Empty means all clients share one conservative anonymous bucket.
TASTEPROBE_TRUSTED_IP_HEADER=
# Server variables only. Never prefix a credential with NEXT_PUBLIC_.
# No model-provider credential is required for the deterministic comparison.
