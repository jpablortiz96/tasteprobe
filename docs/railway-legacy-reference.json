{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci --include=dev && npm run build"
  },
  "deploy": {
    "startCommand": "npm run start:public",
    "numReplicas": 1,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "sleepApplication": false,
    "overlapSeconds": 0
  }
}
